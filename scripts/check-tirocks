#!/usr/bin/env bash
# Compile the workspace-excluded TiRocks implementation in an isolated
# workspace configuration without modifying the checkout's manifest or lockfile.
set -euo pipefail

repo_root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
lock_root="${TMPDIR:-/tmp}/tikv-check-tirocks-locks"
repo_key=$(printf '%s' "$repo_root" | cksum | awk '{print $1}')
workspace_lock="$lock_root/$repo_key.lock"
lock_owner="$workspace_lock/pid"
workspace="$lock_root/$repo_key.workspace"
lock_timeout_secs=${CHECK_TIROCKS_LOCK_TIMEOUT_SECS:-60}
lock_acquired=false

cleanup() {
    local status=$?
    set +e
    if [[ "$lock_acquired" == true ]]; then
        local owner_pid=""
        if [[ -r "$lock_owner" ]]; then
            read -r owner_pid < "$lock_owner"
        fi
        if [[ "$owner_pid" == "$$" ]]; then
            rm -rf "$workspace"
            rm -rf "$workspace_lock"
        fi
    fi
    trap - EXIT INT TERM
    exit "$status"
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

mkdir -p "$lock_root"
lock_deadline=$((SECONDS + lock_timeout_secs))
while ! mkdir "$workspace_lock" 2>/dev/null; do
    owner_pid=""
    if [[ -r "$lock_owner" ]]; then
        read -r owner_pid < "$lock_owner"
    fi
    if [[ "$owner_pid" =~ ^[0-9]+$ ]] && ! kill -0 "$owner_pid" 2>/dev/null; then
        rm -rf "$workspace_lock"
        continue
    fi
    if [[ -z "$owner_pid" ]]; then
        sleep 1
        if [[ ! -r "$lock_owner" ]]; then
            rmdir "$workspace_lock" 2>/dev/null || true
            continue
        fi
    fi
    if (( SECONDS >= lock_deadline )); then
        echo "timed out waiting for TiRocks workspace lock: $workspace_lock" >&2
        exit 1
    fi
    echo "waiting for another TiRocks workspace check to finish"
    sleep 1
done
printf '%s\n' "$$" > "$lock_owner"
lock_acquired=true

rm -rf "$workspace"
mkdir -p "$workspace"
find "$repo_root" -mindepth 1 -maxdepth 1 \
    ! -name Cargo.toml \
    ! -name Cargo.lock \
    ! -name target \
    ! -name .git \
    -exec ln -s '{}' "$workspace/" \;
cp "$repo_root/Cargo.toml" "$repo_root/Cargo.lock" "$workspace/"
sed -i.bak '/"components\/engine_tirocks",/d' "$workspace/Cargo.toml"
rm -f "$workspace/Cargo.toml.bak"

CARGO_TARGET_DIR="$repo_root/target/tirocks-check" \
    cargo check --manifest-path "$workspace/Cargo.toml" -p engine_tirocks
